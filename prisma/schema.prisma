// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
  SITE_INCHARGE
  PROJECT_MANAGER
  CONSTRUCTION_MANAGER
  STORE_INCHARGE
  ACCOUNTANT
}

enum DemandStatus {
  REQUEST_SENT
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  FULFILLED_FROM_STORE
  PO_IN_PROGRESS
  PARTIALLY_PO_CREATED
  PO_CREATED
  ORDER_PLACED
  IN_STORE
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreType {
  HEAD_STORE
  CM_STORE
  SECTION_STORE
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  FULLY_PAID
}

enum VendorAccountTransactionType {
  CREDIT
  DEBIT
}

enum POStatus {
  CREATED
  CONFIRMED
  ORDER_PLACED
  IN_TRANSIT
  IN_STORE
  COMPLETED
  CANCELLED
}

// OTP Model for Password Reset
model OTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  attempts  Int      @default(0)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@unique([email])
  @@map("otps")
}

// Core Models
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  employeeId  String   @unique
  role        UserRole
  isHead      Boolean  @default(false) // For Head Store Incharge, Head Accountant
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  notes       String?

  // User who created this user
  creator     User? @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers User[] @relation("UserCreator")

  // Assignments
  
  siteInchargeAssignments    SiteInchargeAssignment[]
  projectManagerAssignments ProjectManagerAssignment[]
  constructionManagerAssignments ConstructionManagerAssignment[]
  storeInchargeAssignments         StoreInchargeAssignment[]
  headStoreInchargeAssignments     HeadStoreInchargeAssignment[]
  accountantAssignments            AccountantAssignment[]

  // Activity tracking
  demandsCreated             Demand[] @relation("DemandCreator")
  demandsUpdated             Demand[] @relation("DemandUpdater")
  approvals                  DemandApproval[]
  purchaseOrdersCreated      PurchaseOrder[] @relation("POCreator")
  purchaseOrdersAmountAdded  PurchaseOrder[] @relation("POAmountAdder")
  storeTransactions          StoreTransaction[]
  auditLogs                  AuditLog[]
  cmStore                    Store[] @relation("UserCMStore")
  assignedStores             Store[] @relation("StoreAssignedUser")
  deviceTokens               DeviceToken[]
  materialCaps               MaterialCap[] @relation("MaterialCapCreator")
  materialCapsUpdated        MaterialCap[] @relation("MaterialCapUpdater")
  storePermissions           StorePermission[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // For reference number generation
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  sections    Section[]
  siteInchargeAssignments    SiteInchargeAssignment[]
  projectManagerAssignments ProjectManagerAssignment[]
  accountantAssignments            AccountantAssignment[]
  headStoreInchargeAssignments     HeadStoreInchargeAssignment[]
  purchaseOrders            PurchaseOrder[]
  materialCaps              MaterialCap[]
  headStores                Store[] @relation("ProjectHeadStores")

  @@map("projects")
}

model Section {
  id          String   @id @default(cuid())
  name        String
  code        String   // For reference number generation
  description String?
  projectId   String
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  project     Project @relation(fields: [projectId], references: [id])
  
  // All stores in this section (both head and CM stores)
  stores      Store[] @relation("SectionStores")
  
  siteInchargeAssignments    SiteInchargeAssignment[]
  projectManagerAssignments ProjectManagerAssignment[]
  constructionManagerAssignments ConstructionManagerAssignment[]
  accountantAssignments      AccountantAssignment[]
  demands                    Demand[]
  purchaseOrders            PurchaseOrder[]
  materialCaps              MaterialCap[]

  @@unique([projectId, code])
  @@map("sections")
}

// Assignment Models
model SiteInchargeAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  sectionId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String
  
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  
  @@unique([userId, sectionId])
  @@map("site_incharge_assignments")
}

model ProjectManagerAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  sectionId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String
  
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  
  @@unique([userId, sectionId])
  @@map("project_manager_assignments")
}

model ConstructionManagerAssignment {
  id        String   @id @default(cuid())
  userId    String
  sectionId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String
  
  user      User     @relation(fields: [userId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  
  @@unique([userId, sectionId])
  @@map("construction_manager_assignments")
}

model StoreInchargeAssignment {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  isActive    Boolean  @default(true)
  utilityFile String?
  createdAt   DateTime @default(now())
  createdBy   String
  
  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
  
  @@unique([userId, storeId])
  @@map("store_incharge_assignments")
}

model HeadStoreInchargeAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String

  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@map("head_store_incharge_assignments")
}

model AccountantAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  sectionId String?  // null for project-level (isHead) assignments; required for section-level assignments
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String
  
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])
  
  @@unique([userId, projectId, sectionId])
  @@map("accountant_assignments")
}

// Store Management
model Store {
  id               String    @id @default(cuid())
  name             String
  type             StoreType
  sectionId        String?   // Optional: for SECTION_STORE and CM_STORE
  projectId        String?   // For HEAD_STORE (project-level)
  assignedUserId   String?   // Quick-assign personnel field
  cmUserId         String?   // Only for CM stores
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String
  updatedBy        String?

  section     Section?  @relation("SectionStores", fields: [sectionId], references: [id], map: "stores_section_fkey")
  project     Project?  @relation("ProjectHeadStores", fields: [projectId], references: [id], map: "stores_project_fkey")
  cmUser      User?     @relation("UserCMStore", fields: [cmUserId], references: [id], map: "stores_cm_user_fkey")
  assignedUser User?    @relation("StoreAssignedUser", fields: [assignedUserId], references: [id], map: "stores_assigned_user_fkey")

  storeInchargeAssignments StoreInchargeAssignment[]
  inventory                StoreInventory[]
  transactions             StoreTransaction[]  @relation("TransactionStore")
  transactionsFrom         StoreTransaction[]  @relation("TransactionFromStore")
  transactionsTo           StoreTransaction[]  @relation("TransactionToStore")
  fulfillmentsFrom         DemandFulfillment[] @relation("FulfillmentFromStore")
  fulfillmentsTo           DemandFulfillment[] @relation("FulfillmentToStore")
  permissions              StorePermission[]

  @@map("stores")
}

model StorePermission {
  id                  String   @id @default(cuid())
  storeId             String
  userId              String
  canViewStock        Boolean  @default(true)
  canRequestMaterials Boolean  @default(false)
  canApproveMaterials Boolean  @default(false)
  canAddStock         Boolean  @default(false)
  canTransferStock    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, storeId])
  @@map("store_permissions")
}

model Material {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  unit        String   // Default unit
  category    String?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  demands           Demand[]
  storeInventory    StoreInventory[]
  purchaseOrders    PurchaseOrder[]
  materialCaps      MaterialCap[]

  @@map("materials")
}

model MaterialCap {
  id          String   @id @default(cuid())
  materialId  String
  sectionId   String
  projectId   String
  quantity    Decimal
  unit        String
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  material    Material @relation(fields: [materialId], references: [id])
  section     Section  @relation(fields: [sectionId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
  creator     User     @relation("MaterialCapCreator", fields: [createdBy], references: [id])
  updater     User?    @relation("MaterialCapUpdater", fields: [updatedBy], references: [id])

  @@unique([materialId, sectionId])
  @@map("material_caps")
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  purchaseOrders PurchaseOrder[]
  vendorAccounts     VendorAccount[]
  vendorPayments     VendorPayment[]

  @@map("vendors")
}

// Demand Management
model Demand {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  materialId      String
  quantity        Decimal
  unit            String
  poQuantity      Decimal?
  notes           String?
  status          DemandStatus  @default(REQUEST_SENT)
  quantityFulfilled Decimal     @default(0)
  quantityRemaining Decimal?
  sectionId       String
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String        // CM who created
  updatedBy       String?

  section         Section       @relation(fields: [sectionId], references: [id])
  material        Material      @relation(fields: [materialId], references: [id])
  creator         User          @relation("DemandCreator", fields: [createdBy], references: [id])
  updater         User?         @relation("DemandUpdater", fields: [updatedBy], references: [id])

  approvals       DemandApproval[]
  fulfillments    DemandFulfillment[]
  purchaseOrders  PurchaseOrder[]

  @@map("demands")
}

model DemandApproval {
  id        String         @id @default(cuid())
  demandId  String
  userId    String         // Who approved/rejected
  status    ApprovalStatus
  remarks   String?
  createdAt DateTime       @default(now())

  demand    Demand @relation(fields: [demandId], references: [id])
  user      User   @relation(fields: [userId], references: [id])

  @@unique([demandId, userId])
  @@map("demand_approvals")
}

model DemandFulfillment {
  id              String   @id @default(cuid())
  demandId        String
  fromStoreId     String   // Head store fulfilling to CM store
  toStoreId       String   // CM store receiving
  quantity        Decimal
  fulfilledAt     DateTime @default(now())
  fulfilledBy     String   // PM or Site Incharge who fulfilled

  demand          Demand @relation(fields: [demandId], references: [id])
  fromStore       Store  @relation("FulfillmentFromStore", fields: [fromStoreId], references: [id])
  toStore         Store  @relation("FulfillmentToStore", fields: [toStoreId], references: [id])

  @@map("demand_fulfillments")
}

// Purchase Order Management
model PurchaseOrder {
  id              String   @id @default(cuid())
  demandId        String
  projectId       String   // Added for project tracking
  sectionId       String   // Added for section tracking
  referenceNumber String   @unique
  materialId      String   // NEW: direct reference
  vendorId        String   // NEW: direct reference
  quantity        Decimal  // Renamed from totalQuantity
  unitPrice       Decimal? // NEW: price per unit
  totalAmount     Decimal? // NEW: total amount (quantity * unitPrice)
  proofOfBill     String?  // NEW: URL to vendor's bill/invoice
  amountAddedBy     String?  // NEW: who added the amount
  amountAddedAt     DateTime? // NEW: when amount was first added
  amountLastEditedAt DateTime? // when amount was last edited (refreshes 24h window)
  notes           String?  // Optional notes, required when quantity exceeds demand
  status          POStatus @default(CREATED)
  paymentStatus   PaymentStatus @default(PENDING)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String   // Site Incharge who created PO
  updatedBy       String?

  demand          Demand   @relation(fields: [demandId], references: [id])
  project         Project  @relation(fields: [projectId], references: [id])
  section         Section  @relation(fields: [sectionId], references: [id])
  material        Material @relation(fields: [materialId], references: [id])
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  creator         User     @relation("POCreator", fields: [createdBy], references: [id])
  amountAdder     User?    @relation("POAmountAdder", fields: [amountAddedBy], references: [id])

  @@map("purchase_orders")
}

// REMOVE PurchaseOrderItem model

// Store Inventory & Transactions
model StoreInventory {
  id         String   @id @default(cuid())
  storeId    String
  materialId String
  stock      Decimal  @default(0)
  reserved   Decimal  @default(0) // Reserved for pending demands
  available  Decimal  @default(0) // stock - reserved
  updatedAt  DateTime @updatedAt

  store      Store    @relation(fields: [storeId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([storeId, materialId])
  @@map("store_inventory")
}

model StoreTransaction {
  id            String   @id @default(cuid())
  storeId       String
  materialId    String
  type          String   // IN, OUT, TRANSFER
  quantity      Decimal
  reference     String?  // Reference to PO, Demand, etc.
  notes         String?
  documentUrl   String?  // Optional attached document (image/pdf/doc)
  transactionDate DateTime @default(now())
  createdBy     String
  fromStoreId   String?  // Source store (for OUT/TRANSFER — where it came from)
  toStoreId     String?  // Destination store (for IN/TRANSFER — where it went)

  store         Store  @relation("TransactionStore", fields: [storeId], references: [id])
  fromStore     Store? @relation("TransactionFromStore", fields: [fromStoreId], references: [id])
  toStore       Store? @relation("TransactionToStore", fields: [toStoreId], references: [id])
  user          User   @relation(fields: [createdBy], references: [id])

  @@map("store_transactions")
}

// Finance Management - Vendor Level
model VendorAccount {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  totalCredited   Decimal  @default(0)
  totalDebited    Decimal  @default(0)
  balance         Decimal  @default(0)
  lastUpdated     DateTime @updatedAt
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  transactions    VendorAccountTransaction[]
}

model VendorAccountTransaction {
  id              String   @id @default(cuid())
  vendorAccountId String
  type            VendorAccountTransactionType
  amount          Decimal
  purchaseOrderId String?
  vendorPaymentId String?
  projectId       String?  // project context for payment (DEBIT) transactions
  sectionId       String?  // section context for payment (DEBIT) transactions
  addedBy         String
  createdAt       DateTime @default(now())
  proofOfPayment  String?
  note            String?

  vendorAccount   VendorAccount @relation(fields: [vendorAccountId], references: [id])
}

model VendorPayment {
  id             String   @id @default(cuid())
  vendorId       String
  projectId      String?  // project this payment is attributed to
  sectionId      String?  // section this payment is attributed to
  amount         Decimal
  addedBy        String
  createdAt      DateTime @default(now())
  proofOfPayment String?
  note           String?

  vendor         Vendor   @relation(fields: [vendorId], references: [id])
}

// Audit Trail
model AuditLog {
  id          String   @id @default(cuid())
  tableName   String
  recordId    String
  action      String   // CREATE, UPDATE, DELETE
  oldValues   Json?
  newValues   Json?
  changedBy   String
  changedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  user        User @relation(fields: [changedBy], references: [id])

  @@index([tableName, recordId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("audit_logs")
}

// Reference Number Counter
model ReferenceCounter {
  id        String @id @default(cuid())
  prefix    String @unique // DCRA
  projectCode String
  sectionCode String
  counter   Int    @default(0)
  
  @@unique([projectCode, sectionCode])
  @@map("reference_counters")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // e.g., 'web', 'android', 'ios'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}