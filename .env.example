# ============================================================================
# Construction Backend - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the appropriate values for your environment

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@localhost:5432/construction_db
DATABASE_URL=postgresql://user:password@localhost:5432/construction_db

# ============================================================================
# JWT Authentication
# ============================================================================
# Secret key for JWT token signing and verification (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# ============================================================================
# Email Configuration (Gmail)
# ============================================================================
# Gmail account for sending notifications and password reset emails
GMAIL_USER=your_gmail@gmail.com
# Gmail app-specific password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_PASS=your_gmail_app_password

# Optional: Email recipient for test emails
TEST_EMAIL_TO=test@example.com

# ============================================================================
# AWS S3 Configuration
# ============================================================================
# AWS region where your S3 bucket is located (e.g., us-east-1, ap-south-1)
AWS_REGION=us-east-1
# AWS Access Key ID for S3 authentication
AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS Secret Access Key for S3 authentication
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3 bucket name for file uploads (proofs, bills, etc)
AWS_BUCKET_NAME=your-construction-bucket

# ============================================================================
# Firebase Configuration
# ============================================================================
# Firebase service account JSON file path
# Expected at: src/config/radc-a6ce0-firebase-adminsdk-fbsvc-c5f458f8f6.json
# Used for push notifications via Firebase Admin SDK

# ============================================================================
# Zoom Configuration (Optional)
# ============================================================================
# Zoom account credentials for potential video integration
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ============================================================================
# Cloudinary Configuration (Optional)
# ============================================================================
# Cloudinary cloud name and credentials for image/file management
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
